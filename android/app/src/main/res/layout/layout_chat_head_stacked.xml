<?xml version="1.0" encoding="utf-8"?>
<!--
  Stacked chat-head bubble: up to 3 overlapping avatar circles (newest on top).
  Uses FrameLayout + oval drawables (NOT CardView) so WindowManager overlays
  have no rectangular translucent shadow/backing behind the circles.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp"
    android:layout_height="84dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <!-- Avatar 3 - oldest/furthest-back sender (44 dp) -->
    <FrameLayout
        android:id="@+id/cvAvatarBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/bg_chat_head_avatar"
        android:visibility="gone"
        android:elevation="0dp">

        <TextView
            android:id="@+id/tvInitialsBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/color_background"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivPicBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Avatar" />

        <TextureView
            android:id="@+id/vvPicBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Avatar 2 - middle sender (50 dp) -->
    <FrameLayout
        android:id="@+id/cvAvatarMid"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/bg_chat_head_avatar"
        android:visibility="gone"
        android:elevation="0dp">

        <TextView
            android:id="@+id/tvInitialsMid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/color_background"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivPicMid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Avatar" />

        <TextureView
            android:id="@+id/vvPicMid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Avatar 1 - newest sender, front-most (56 dp) -->
    <FrameLayout
        android:id="@+id/cvAvatarFront"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/bg_chat_head_avatar"
        android:elevation="0dp">

        <TextView
            android:id="@+id/tvInitialsFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/color_background"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivPicFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Avatar" />

        <TextureView
            android:id="@+id/vvPicFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Total-chat count (yellow) when >3 chats - opposite side of unread badge -->
    <FrameLayout
        android:id="@+id/chatHeadStackCountCard"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:visibility="gone"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvChatHeadStackCount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </FrameLayout>

    <!-- Unread badge - top-end (right) of the frame -->
    <FrameLayout
        android:id="@+id/chatHeadBadgeCard"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:visibility="gone"
        android:background="@drawable/bg_chat_head_badge"
        android:elevation="0dp">

        <TextView
            android:id="@+id/tvChatHeadBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </FrameLayout>

</FrameLayout>
