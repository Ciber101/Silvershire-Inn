<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="#44C9A84C"
        android:backgroundTint="@color/color_silver" />

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Shared Files"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendFile"
            style="@style/Widget.Silvershire.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send File"
            android:textColor="@color/color_gold"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider" />

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:tabTextColor="@color/color_text_secondary"
        app:tabSelectedTextColor="@color/color_gold"
        app:tabIndicatorColor="@color/color_gold"
        app:tabMode="fixed" />

    <!-- File list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSharedFiles"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        android:paddingHorizontal="8dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvNoFiles"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:gravity="center"
        android:text="No files shared yet"
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
