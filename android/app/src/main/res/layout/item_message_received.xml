<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp"
    android:paddingStart="10dp"
    android:paddingEnd="48dp"
    android:clipChildren="false"
    android:clipToPadding="false">


    <com.silvershireinn.app.ui.chat.SealBubble
        android:id="@+id/bubbleReceived"
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/message_bubble_max_width"
        android:orientation="vertical"
        android:background="@drawable/bg_message_received"
        android:padding="14dp">

        <!-- Sender name - only visible in group chats -->
        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_gold"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="2dp"
            android:visibility="gone" />

        <!-- Reply quote chip — shown for reply messages; tap to jump to the original. -->
        <TextView
            android:id="@+id/tvReplyQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/color_gold"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:padding="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_reply_quote"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:autoLink="none" />

        <!-- Link preview card (shown when message contains a URL): picture, site, title -->
        <com.silvershireinn.app.ui.chat.LinkCard
            android:id="@+id/layoutLinkPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_link_card">

            <FrameLayout
                android:id="@+id/frameLinkImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF101013"
                android:visibility="gone">

                <com.silvershireinn.app.ui.chat.AspectImageView
                    android:id="@+id/ivLinkPreviewImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <FrameLayout
                    android:id="@+id/linkPlay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_link_play"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="8dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/tvLinkDomain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:alpha="0.65"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvLinkTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvLinkDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:alpha="0.75"
                    android:textSize="12.5sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.silvershireinn.app.ui.chat.LinkCard>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApkDownload"
            style="@style/Widget.Silvershire.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Download"
            android:textAllCaps="false"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="10sp" />

    </com.silvershireinn.app.ui.chat.SealBubble>
    <!-- (after the bubble so it is drawn on top) Friend's portrait, set into the bubble's top corner like a seal (SealBubble) -->
    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvSenderInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivSenderAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
