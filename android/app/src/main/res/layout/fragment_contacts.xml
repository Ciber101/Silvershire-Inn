<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <TextView
            android:id="@+id/tvFriendRequestBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33CF6679"
            android:padding="12dp"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:visibility="gone" />
        <View
            android:id="@+id/bannerFriendRequests"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_bar"
            app:tabTextColor="@color/color_text_secondary"
            app:tabSelectedTextColor="@color/color_gold"
            app:tabIndicatorColor="@color/color_gold"
            app:tabMode="fixed" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInvites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No contacts yet.\nTap + to find someone."
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyInvites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No pending invites"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Add contact"
        android:textColor="@color/color_background"
        app:backgroundTint="@color/color_silver"
        app:icon="@drawable/ic_contacts"
        app:iconTint="@color/color_background"
        app:cornerRadius="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
