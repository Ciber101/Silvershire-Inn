<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp"
    android:paddingStart="10dp"
    android:paddingEnd="48dp"
    android:clipChildren="false"
    android:clipToPadding="false">


    <com.silvershireinn.app.ui.chat.SealBubble
        android:id="@+id/bubbleAudioReceived"
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="200dp"
        android:maxWidth="280dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_message_received"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_voice_play_circle"
            android:src="@drawable/ic_play"
            android:tint="@color/color_gold"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:contentDescription="Play voice message" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <com.silvershireinn.app.ui.chat.WaveformView
                android:id="@+id/waveformAudio"
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <SeekBar
                android:id="@+id/seekBarAudio"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:max="1000"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00" />
                <TextView
                    android:id="@+id/tvAudioSpeed"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content" android:minHeight="18dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:background="@drawable/bg_speed_chip"
                    android:textColor="@color/color_gold"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="1x" />


                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </com.silvershireinn.app.ui.chat.SealBubble>
    <!-- (after the bubble so it is drawn on top) Friend's portrait, set into the bubble's top corner like a seal (SealBubble) -->
    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvSenderInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivSenderAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
