<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1208">

    <!-- Back / minimise -->
    <ImageButton
        android:id="@+id/btnCallBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_back"
        android:tint="#FFC9A84C"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"/>

    <!-- Their picture (with their border around it) -->
    <FrameLayout
        android:id="@+id/callAvatarWrap"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="110dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="60dp"
        app:cardBackgroundColor="#2A1E08"
        app:cardElevation="0dp"
        app:strokeColor="#FFC9A84C"
        app:strokeWidth="2dp">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFC9A84C"
            android:textSize="52sp"
            android:fontFamily="sans-serif-medium"/>

        <ImageView
            android:id="@+id/ivCallAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no"/>

    </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Contact name -->
    <TextView
        android:id="@+id/tvCallName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="..."
        android:textColor="#FFFFD700"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/callAvatarWrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Status / timer text -->
    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting…"
        android:textColor="#FFC0A060"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvCallName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <!-- ── Incoming-call buttons (accept / reject) ── -->
    <LinearLayout
        android:id="@+id/layoutIncomingButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutCallControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="36dp">

        <!-- Reject -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="48dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRejectCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="#FFCC2222"
                app:cardElevation="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_call_end"
                    android:scaleType="center"
                    android:padding="16dp"
                    android:tint="#FFFFFFFF"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decline"
                android:textColor="#FFC9A84C"
                android:textSize="11sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Accept -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAcceptCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="#FF22AA44"
                app:cardElevation="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_call"
                    android:scaleType="center"
                    android:padding="16dp"
                    android:tint="#FFFFFFFF"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accept"
                android:textColor="#FFC9A84C"
                android:textSize="11sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Active call controls: mute · end · speaker ── -->
    <LinearLayout
        android:id="@+id/layoutCallControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="60dp">

        <!-- Mute -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="32dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMute"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#2A1E08"
                app:strokeColor="#FFC9A84C"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivMuteIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_mic"
                    android:scaleType="center"
                    android:padding="14dp"
                    android:tint="#FFC9A84C"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMuteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mute"
                android:textColor="#FFC9A84C"
                android:textSize="11sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- End Call -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="32dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnEndCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="#FFCC2222"
                app:cardElevation="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_call_end"
                    android:scaleType="center"
                    android:padding="16dp"
                    android:tint="#FFFFFFFF"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Call"
                android:textColor="#FFC9A84C"
                android:textSize="11sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Speaker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSpeaker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#2A1E08"
                app:strokeColor="#FFC9A84C"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivSpeakerIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_speaker"
                    android:scaleType="center"
                    android:padding="14dp"
                    android:tint="#FFC9A84C"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="#FFC9A84C"
                android:textSize="11sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
