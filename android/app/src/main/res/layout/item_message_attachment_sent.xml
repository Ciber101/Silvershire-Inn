<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp"
    android:paddingStart="56dp"
    android:paddingEnd="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.silvershireinn.app.ui.chat.SealBubble
        android:id="@+id/bubbleAttachmentSent"
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/message_bubble_max_width"
        android:orientation="vertical"
        android:background="@drawable/bg_message_sent_delivered"
        android:padding="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Inline image preview (visible for image/* mimeTypes) -->
        <FrameLayout
            android:id="@+id/frameMediaPreview"
            android:layout_width="@dimen/attachment_preview_width"
            android:layout_height="180dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            android:background="#1A000000">

            <ImageView
                android:id="@+id/ivMediaPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Image preview" />

            <!-- Video play overlay (shown for video/* types) -->
            <ImageView
                android:id="@+id/tvPlayOverlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_play_overlay"
                android:padding="15dp"
                android:src="@drawable/ic_play"
                android:importantForAccessibility="no"
                android:visibility="gone" />

        </FrameLayout>

        <!-- File icon + name row (hidden for images, shown for other files) -->
        <LinearLayout
            android:id="@+id/rowFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/tvFileEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:drawableStart="@drawable/ic_attach"
                android:drawableTint="#E6C25A"
                android:drawableTintMode="multiply"
                android:textSize="24sp"
                android:layout_marginEnd="8dp" />

            <!-- Shown instead of tvFileEmoji while a file is uploading -->
            <ProgressBar
                android:id="@+id/progressUpload"
                style="?android:attr/progressBarStyle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAttachmentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/tvAttachmentSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Download / Open button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadAttachment"
            style="@style/Widget.Silvershire.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Download"
            android:textColor="@color/color_gold"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="4dp" />

        <!-- Timestamp + delivery status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDeliveryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/color_gold"
                android:textSize="11sp"
                android:letterSpacing="-0.12" />

        </LinearLayout>

    </com.silvershireinn.app.ui.chat.SealBubble>
    <!-- Your own picture beside your messages (setting "My picture in chats", off by default) -->
    <FrameLayout
        android:id="@+id/avatarFrameMine"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvMyInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/ivMyAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
