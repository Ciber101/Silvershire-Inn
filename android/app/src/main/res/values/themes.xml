<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Silvershire" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorLink">#E8C547</item>
        <item name="colorPrimary">@color/color_gold</item>
        <item name="colorPrimaryVariant">@color/color_gold_dark</item>
        <item name="colorOnPrimary">@color/color_background</item>
        <item name="colorSecondary">@color/color_gold</item>
        <item name="colorSecondaryVariant">@color/color_gold_dark</item>
        <item name="colorOnSecondary">@color/color_background</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorError">@color/color_error</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="actionBarStyle">@style/Widget.Silvershire.ActionBar</item>
        <!-- Button text in the same lettering as everything else (no ALL CAPS / wide spacing) -->
        <item name="textAppearanceButton">@style/TextAppearance.Silvershire.Button</item>
        <item name="android:textAppearanceButton">@style/TextAppearance.Silvershire.Button</item>
    </style>

    <style name="TextAppearance.Silvershire.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Silvershire.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/color_surface</item>
        <item name="titleTextStyle">@style/TextStyle.Silvershire.Title</item>
        <item name="subtitleTextStyle">@style/TextStyle.Silvershire.Subtitle</item>
    </style>

    <style name="TextStyle.Silvershire.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextStyle.Silvershire.Subtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.Silvershire.Splash" parent="Theme.Silvershire">
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Widget.Silvershire.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_silver</item>
        <item name="android:textColor">@color/color_background</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/color_gold</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="rippleColor">@color/color_gold_dim</item>
    </style>

    <!-- Message send stays yellow/gold (use this on composer send FABs) -->
    <style name="Widget.Silvershire.Button.Send" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_gold</item>
        <item name="android:textColor">@color/color_background</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Silvershire.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="strokeColor">@color/color_gold</item>
        <item name="rippleColor">@color/color_gold_dim</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Silvershire.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="rippleColor">@color/color_gold_dim</item>
    </style>

    <style name="Widget.Silvershire.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/color_gold</item>
        <item name="hintTextColor">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
